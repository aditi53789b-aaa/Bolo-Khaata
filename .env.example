# Copy to .env and replace every placeholder before deployment.
APP_ENV=production
PORT=8000
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=60
POSTGRES_DB=bolokhaata
POSTGRES_USER=bolokhaata
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg2://bolokhaata:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/bolokhaata
CORS_ORIGINS=https://your-domain.example
ALLOWED_HOSTS=your-domain.example
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@your-domain.example
PASSWORD_RESET_URL=https://your-domain.example/auth.html?mode=reset
BUSINESS_TIMEZONE=Asia/Kolkata
TERMS_VERSION=2026-11-21

# --- Speech (voice entry) ---
# Same SPEECH_API_KEY / SPEECH_WS_SECRET values must be set on the Next.js side (see gauri-module/.env.example).
SPEECH_API_KEY=REPLACE_WITH_A_RANDOM_SECRET
SPEECH_WS_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
SPEECH_WEBHOOK_SECRET=REPLACE_WITH_A_THIRD_RANDOM_SECRET
WEBHOOK_ALLOWED_HOSTS=your-domain.example
ALLOWED_ORIGINS=https://your-domain.example
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
OPENAI_API_KEY=            # used by Whisper transcription
# SPEECH_ENV=dev           # LOCAL ONLY: skips the speech key/token checks. Never set in production.

